{
  "name": "app",
  "main": "src/index.js",
  "compatibility_date": "2025-03-01",

  "rules": [
    { "type": "Text", "globs": ["**/*.html"] }
  ],

  "routes": [
    {
      "pattern": "app.eno.solutions/*",
      "zone_name": "eno.solutions"
    }
  ],

  "vars": {
    "MOCK_API_BASE_URL": "https://portal.zoomdemos.com/userapi/YOUR_USER_ID"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "zcc_crm_demo",
      "database_id": "c0b21236-dae8-4a3d-b34b-b067e4eaa61a"
    }
  ]
}
